__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
.env
.env.*
*.gguf
*.pt
models/
traces/
hf-cache/
.cache/
outputs/
datasets/
*.jsonl
*.jsonl.gz
*.ckpt
*.pth
*.bin
*.safetensors
*.safetensors.index.json
*.onnx

# Ignore all of data/'s contents by default (model caches, external datasets,
# top-level JSONL). The directory itself stays un-excluded so specific files
# below can be re-included.
data/*

# Capability benchmark: keep the large split JSONL out of Git, but check in the
# small manifests + samples (deterministic regeneration is documented in each).
# Re-include the two capability-benchmark directories first (a file cannot be
# re-included if its parent directory is excluded), then ignore their contents
# again except the manifest + sample.
!data/capability-benchmark/
data/capability-benchmark/*
!data/capability-benchmark/capability-benchmark-manifest.json
!data/capability-benchmark/capability-benchmark-sample.jsonl
!data/capability-benchmark-full/
data/capability-benchmark-full/*
!data/capability-benchmark-full/capability-benchmark-manifest.json
!data/capability-benchmark-full/capability-benchmark-sample.jsonl

# Ignore the contents of reports/ and checkpoints/ (not the dirs themselves)
# so the calibration config + held-out reports can be re-included below.
reports/*
checkpoints/*

# Re-include the specific report files we commit.
!reports/calibration.json
!reports/evaluation_calibrated.json
!reports/evaluation.json

# Re-include the calibration config (requires un-ignoring the parent dir first).
!checkpoints/local-distilbert/
checkpoints/local-distilbert/*
!checkpoints/local-distilbert/jev_laya_config.json
